[Unit]
Description=Check VPN proxy connectivity and report exit IP changes
After=rk-vpn-proxy.service
Requires=rk-vpn-proxy.service

[Service]
Type=oneshot
User=hcq
Group=hcq
StateDirectory=rk-vpn-proxy
ExecStart=/usr/local/libexec/rk-vpn-proxy-health
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
