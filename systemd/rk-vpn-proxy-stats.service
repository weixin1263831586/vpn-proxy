[Unit]
Description=Read-only client statistics dashboard for the HTTP proxy
After=network-online.target rk-vpn-proxy.service
Wants=rk-vpn-proxy.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/libexec/rk-vpn-proxy-client-stats --serve --config /etc/rk-vpn-proxy/config.json
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Loopback-only listener; access through an SSH tunnel, not the network.

[Install]
WantedBy=multi-user.target
