#!/bin/bash
# Source this script in Bash to configure both this terminal and future shells.
# Optional first argument: a different HTTP(S) proxy URL.
_rk_vpn_install() {
    local proxy=${1:-${RK_VPN_PROXY_URL:-@@PROXY_URL@@}}
    local test_url=${RK_VPN_TEST_URL:-@@TEST_URL@@}
    local extra_no_proxy=${RK_VPN_NO_PROXY:-@@NO_PROXY@@}
    case "$proxy" in
        http://?*|https://?*) ;;
        *) echo 'Expected an http:// or https:// proxy URL.' >&2; return 1 ;;
    esac
    if RK_VPN_INSTALL_PROXY="$proxy" RK_VPN_INSTALL_TEST_URL="$test_url" \
        RK_VPN_INSTALL_NO_PROXY="$extra_no_proxy" bash <<'RK_VPN_INSTALL_BODY'
set -euo pipefail
umask 077
command -v curl >/dev/null
proxy=$RK_VPN_INSTALL_PROXY
echo "Checking proxy: $proxy"
# Probe first; failed connectivity must not overwrite persistent settings.
probe=$(curl --silent --show-error --fail --noproxy '' --proxy "$proxy" \
    --connect-timeout 20 --max-time 45 --retry 2 --retry-delay 2 \
    --retry-max-time 90 --retry-connrefused --head --output /dev/null \
    --write-out '%{http_connect} %{http_code}' "$RK_VPN_INSTALL_TEST_URL")
read -r connect_status http_status <<< "$probe"
[[ "$connect_status" == 200 && "$http_status" =~ ^[23][0-9][0-9]$ ]] || {
    printf 'HTTPS proxy check failed: %s\n' "$probe" >&2
    exit 1
}
client_dir="$HOME/.config/rk-vpn-proxy"
mkdir -p "$client_dir/backups"
chmod 0700 "$client_dir" "$client_dir/backups"
# Restrict backups from earlier installations as well.
chmod -R go-rwx "$client_dir/backups"
backup_dir=$(mktemp -d "$client_dir/backups/$(date +%Y%m%d-%H%M%S).XXXXXX")
for file in "$client_dir/env.sh" "$HOME/.bashrc" "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bash_login"; do
    [[ ! -f "$file" ]] || cp -p "$file" "$backup_dir/$(basename "$file")"
done
temporary_env=$(mktemp "$client_dir/.env.XXXXXX")
trap 'rm -- "$temporary_env" 2>/dev/null || true' EXIT
{
    printf '%s\n' '[ -n "${BASH_VERSION:-}" ] || return 0'
    printf '_rk_vpn_proxy_url=%q\n' "$proxy"
    printf '_rk_vpn_extra_no_proxy=%q\n' "$RK_VPN_INSTALL_NO_PROXY"
    cat <<'RK_VPN_ENVIRONMENT'
# Shared client environment body; installer prepends the chosen proxy URL.
# Source the installed file: . ~/.config/rk-vpn-proxy/env.sh
unset ALL_PROXY all_proxy
export http_proxy="$_rk_vpn_proxy_url"
export https_proxy="$http_proxy"
export HTTP_PROXY="$http_proxy"
export HTTPS_PROXY="$http_proxy"
no_proxy=${no_proxy:-${NO_PROXY:-}}
_rk_vpn_proxy_host=${http_proxy#*://}
_rk_vpn_proxy_host=${_rk_vpn_proxy_host##*@}
if [[ $_rk_vpn_proxy_host == \[* ]]; then
    _rk_vpn_proxy_host=${_rk_vpn_proxy_host#\[}
    _rk_vpn_proxy_host=${_rk_vpn_proxy_host%%\]*}
else
    _rk_vpn_proxy_host=${_rk_vpn_proxy_host%%[:/]*}
fi
IFS=, read -r -a _rk_vpn_hosts <<< "localhost,127.0.0.1,::1,$_rk_vpn_proxy_host,$_rk_vpn_extra_no_proxy"
for _rk_vpn_host in "${_rk_vpn_hosts[@]}"; do
    [[ -n $_rk_vpn_host ]] || continue
    case ",$no_proxy," in
        *",$_rk_vpn_host,"*) ;;
        *) no_proxy="${no_proxy:+$no_proxy,}$_rk_vpn_host" ;;
    esac
done
unset _rk_vpn_hosts _rk_vpn_host _rk_vpn_proxy_host _rk_vpn_proxy_url _rk_vpn_extra_no_proxy
export no_proxy
export NO_PROXY="$no_proxy"
RK_VPN_ENVIRONMENT
} > "$temporary_env"
chmod 0600 "$temporary_env"
mv -- "$temporary_env" "$client_dir/env.sh"
trap - EXIT
startup_files=(.bashrc .profile)
if [[ -f "$HOME/.bash_profile" ]]; then
    startup_files+=(.bash_profile)
elif [[ -f "$HOME/.bash_login" ]]; then
    startup_files+=(.bash_login)
fi
for startup in "${startup_files[@]}"; do
    target="$HOME/$startup"
    if ! grep -qF '# rk-vpn-proxy environment' "$target" 2>/dev/null; then
        cat >> "$target" <<'RK_VPN_STARTUP'

# rk-vpn-proxy environment
if [ -r "$HOME/.config/rk-vpn-proxy/env.sh" ]; then
    . "$HOME/.config/rk-vpn-proxy/env.sh"
fi
RK_VPN_STARTUP
    fi
done
printf 'Installed proxy: %s\nBackups: %s\n' "$proxy" "$backup_dir"
RK_VPN_INSTALL_BODY
    then
        source "$HOME/.config/rk-vpn-proxy/env.sh" || return
        unset -f _rk_vpn_install
        printf '\nTesting: curl -I %s\n' "$test_url"
        curl -I --connect-timeout 20 --max-time 45 --retry 2 \
            --retry-delay 2 --retry-max-time 90 --retry-connrefused "$test_url"
    else
        unset -f _rk_vpn_install
        echo 'Installation failed; check proxy connectivity and the error above.' >&2
        return 1
    fi
}
_rk_vpn_install "$@"
